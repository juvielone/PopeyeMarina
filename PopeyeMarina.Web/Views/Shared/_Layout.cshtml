@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var recordsExpanded =
        currentController == "Docks" ||
        currentController == "Slips";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Popeye Marina</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">

        <aside class="sidebar">

            

            <div class="sidebar-brand">
                <a asp-controller="Dashboard"
                   asp-action="Index">
                    <img src="~/images/logo.png"
                         alt="Popeye Marina"
                         class="sidebar-logo" />
                </a>
            </div>

            <nav class="sidebar-nav nav flex-column">
                <a class="nav-link"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="bi bi-speedometer2 me-2"></i>
                    Dashboard

                </a>

                <a class="nav-link"
                   asp-controller="BoatHire"
                   asp-action="Index">
                    <i class="bi bi-life-preserver me-2"></i>
                    Boat Hire
                </a>


                <a class="nav-link"
                   asp-controller="Customers"
                   asp-action="Index">
                    <i class="bi bi-people me-2"></i>
                    Customers
                </a>


                <a class="nav-link"
                   asp-controller="Boats"
                   asp-action="Index">
                    <i class="bi bi-water me-2"></i>
                    Boats
                </a>


                <a class="nav-link"
                   asp-controller="Leases"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Leases
                </a>

                <!-- Records -->

                <a class="nav-link @(recordsExpanded ? "active" : "")"
                   data-bs-toggle="collapse"
                   href="#recordsMenu"
                   role="button"
                   aria-expanded="@(recordsExpanded.ToString().ToLower())"
                   aria-controls="recordsMenu">
                    <i class="bi bi-folder2-open me-2"></i>
                    <span>Records</span>

                    <span class="ms-auto">
                        <i class="bi bi-chevron-down me-5"></i>
                    </span>

                </a>

                <div class="collapse @(recordsExpanded ? "show" : "")"
                     id="recordsMenu">

                    <ul class="nav flex-column ms-3">

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Docks" ? "active" : "")"
                               asp-controller="Docks"
                               asp-action="Index">
                                Docks
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Slips" ? "active" : "")"
                               asp-controller="Slips"
                               asp-action="Index">
                                Slips
                            </a>
                        </li>

                    </ul>

                </div>

                <form asp-controller="Account" asp-action="Logout" method="post" class="mt-3">
                    <button type="submit" class="nav-link btn btn-link text-start w-100">
                        Logout
                    </button>
                </form>
            </nav>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>