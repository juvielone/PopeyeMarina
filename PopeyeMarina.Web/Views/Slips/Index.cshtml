@model PopeyeMarina.Web.ViewModels.SlipsPageModel

@{
    ViewData["Title"] = "Slips";
    bool isEditing = Model.Form.SlipID is not null;
}

<div class="container-fluid">

    <div class="mb-4">
        <h1>Slips</h1>
        <p class="text-muted mb-0">Manage marina slips.</p>
    </div>

    <!-- Add / Edit Slip -->
    <div class="card mb-4">
        <div class="card-body">

            <h5 class="card-title mb-4">
                @(isEditing
                    ? $"Edit slip #{Model.Form.SlipID}"
                    : "Add new slip")
            </h5>

            <form asp-controller="Slips"
                  asp-action="Save"
                  method="post">

                @if (isEditing)
                {
                    <input type="hidden" asp-for="Form.SlipID" />
                }

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">

                    <!-- Width -->
                    <div class="col-md-4">
                        <label asp-for="Form.Width"
                               class="form-label">
                            Width
                        </label>

                        <input asp-for="Form.Width"
                               type="number"
                               class="form-control"
                               step="any"
                               required />

                        <span asp-validation-for="Form.Width"
                              class="text-danger"></span>
                    </div>

                    <!-- Slip Length -->
                    <div class="col-md-4">
                        <label asp-for="Form.SlipLength"
                               class="form-label">
                            Slip Length
                        </label>

                        <input asp-for="Form.SlipLength"
                               type="number"
                               class="form-control"
                               step="any"
                               required />

                        <span asp-validation-for="Form.SlipLength"
                              class="text-danger"></span>
                    </div>

                    <!-- Dock -->
                    <div class="col-md-4">
                        <label asp-for="Form.DockID"
                               class="form-label">
                            Dock
                        </label>

                        <select asp-for="Form.DockID"
                                class="form-select"
                                required>

                            <option value="">Select Dock</option>

                            @foreach (var dock in Model.Docks)
                            {
                                <option value="@dock.DockID">
                                    Dock @dock.DockID — @dock.Location
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Form.DockID"
                              class="text-danger"></span>
                    </div>

                    <!-- Covered Slip -->
                    <div class="col-12">
                        <div class="form-check">

                            <input asp-for="Form.IsCovered"
                                   type="checkbox"
                                   class="form-check-input"
                                   id="IsCovered" />

                            <label asp-for="Form.IsCovered"
                                   class="form-check-label">
                                Covered Slip
                            </label>

                        </div>
                    </div>

                    <!-- Covered Slip Fields -->
                    <div id="coveredFields"
                         class="row g-3 d-none">

                        <!-- Height -->
                        <div class="col-md-6">
                            <label asp-for="Form.Height"
                                   class="form-label">
                                Height
                            </label>

                            <input asp-for="Form.Height"
                                   type="number"
                                   class="form-control"
                                   step="any" />

                            <span asp-validation-for="Form.Height"
                                  class="text-danger"></span>
                        </div>

                        <!-- Door Type -->
                        <div class="col-md-6">
                            <label asp-for="Form.DoorType"
                                   class="form-label">
                                Door Type
                            </label>

                            <input asp-for="Form.DoorType"
                                   class="form-control" />

                            <span asp-validation-for="Form.DoorType"
                                  class="text-danger"></span>
                        </div>

                    </div>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        @(isEditing ? "Save Changes" : "Add Slip")
                    </button>

                    @if (isEditing)
                    {
                        <a asp-controller="Slips"
                           asp-action="Index"
                           class="btn btn-link">
                            Cancel
                        </a>
                    }

                </div>

            </form>

        </div>
    </div>

    <!-- Existing Slip Table -->
    <div class="table-responsive">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Slip ID</th>
                    <th>Dock</th>
                    <th>Width</th>
                    <th>Slip Length</th>
                    <th>Covered</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var slip in Model.Slips)
                {
                    var dock = Model.Docks
                        .FirstOrDefault(d => d.DockID == slip.DockID);

                    <tr>
                        <td>@slip.SlipID</td>

                        <td>
                            @(dock != null
                                ? $"Dock {dock.DockID} — {dock.Location}"
                                : $"Dock {slip.DockID}")
                        </td>

                        <td>@slip.Width</td>

                        <td>@slip.SlipLength</td>

                        <td>
                            @(slip.IsCovered ? "Yes" : "No")
                        </td>

                        <td>
                            <a asp-controller="Slips"
                               asp-action="Edit"
                               asp-route-id="@slip.SlipID"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>
        const coveredCheckbox =
            document.getElementById("IsCovered");

        const coveredFields =
            document.getElementById("coveredFields");

        function updateCoveredFields() {
            coveredFields.classList.toggle(
                "d-none",
                !coveredCheckbox.checked
            );
        }

        coveredCheckbox.addEventListener(
            "change",
            updateCoveredFields
        );

        updateCoveredFields();
    </script>

}